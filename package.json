{
  "name": "abrir-com-externo",
  "displayName": "Abrir com programa externo",
  "description": "Escolha no VS Code um aplicativo associado no Windows para abrir o arquivo.",
  "version": "0.1.1",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "abrirComExterno.open",
        "title": "Abrir com programa externo…",
        "category": "Arquivo",
        "enablement": "isWindows"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "abrirComExterno.open",
          "when": "isWindows && resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "abrirComExterno.open",
          "when": "isWindows && resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "abrirComExterno.open",
          "when": "isWindows && resourceScheme == file",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository --out abrir-com-externo-0.1.1.vsix"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.7.1",
    "typescript": "5.9.3"
  },
  "private": true
}
